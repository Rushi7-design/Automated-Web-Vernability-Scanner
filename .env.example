# AWVS Environment Configuration Template
# Copy this file to .env and configure your local settings.
# DO NOT commit .env with real secrets to version control.

SECRET_KEY=your-super-secret-key-change-in-production
MONGO_URI=mongodb://localhost:27017/awvs
AWVS_API_KEY=your-secret-api-key-here
DEBUG=True
MAX_CRAWL_DEPTH=3
MAX_CRAWL_PAGES=100
REQUEST_TIMEOUT=10
REPORTS_DIR=reports
